modules = ["python-3.11"]
run = "uv run --extra benchmark python -m faultloc serve"

packager.language = "python3"

[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[deployment]
build = "UV_PROJECT_ENVIRONMENT=.deployment-venv uv sync --frozen --extra benchmark"
run = [".deployment-venv/bin/python", "-m", "faultloc", "serve"]
deploymentTarget = "cloudrun"
