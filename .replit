modules = ["python-3.11"]
run = "uv run python -m faultloc serve"

packager.language = "python3"

[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[deployment]
build = "UV_PROJECT_ENVIRONMENT=.venv uv sync --frozen"
run = [".venv/bin/python", "-m", "faultloc", "serve"]
deploymentTarget = "cloudrun"
